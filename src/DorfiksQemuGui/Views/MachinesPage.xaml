<Page x:Class="DorfiksQemuGui.Views.MachinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:DorfiksQemuGui.Models">
    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <TextBlock Text="Machines" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Edit" Click="Edit_Click"/>
                <Button Content="Delete" Click="Delete_Click"/>
                <Button Content="Start" Style="{StaticResource AccentButtonStyle}" Click="Start_Click"/>
                <Button Content="New machine" Click="New_Click"/>
            </StackPanel>
        </Grid>
        <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" DoubleTapped="Start_Click">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:VmConfig">
                    <Grid Padding="8,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="28" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Summary}" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="Empty" Grid.Row="1" Text="No machines yet. Press “New machine”." Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>
