<Page x:Class="DorfiksQemuGui.Views.MachinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:DorfiksQemuGui.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar x:Name="Bar" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                    HorizontalAlignment="Left" Margin="8,4,0,0">
            <AppBarButton Icon="Add" Label="New" Click="New_Click"/>
            <AppBarButton x:Name="SettingsBtn" Icon="Setting" Label="Settings" Click="Edit_Click"/>
            <AppBarButton x:Name="CloneBtn" Icon="Copy" Label="Clone" Click="Clone_Click"/>
            <AppBarButton x:Name="DeleteBtn" Icon="Delete" Label="Delete" Click="Delete_Click"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="StartBtn" Icon="Play" Label="Start" Click="Start_Click"/>
        </CommandBar>
        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="List" SelectionMode="Single" Margin="8,0,0,8" DoubleTapped="Start_Click"
                      SelectionChanged="List_SelectionChanged"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:VmConfig">
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" FontSize="24" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Preset}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1" Padding="16,0,16,8">
                <StackPanel x:Name="Details" Spacing="12"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
