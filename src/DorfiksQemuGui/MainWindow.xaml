<Window x:Class="DorfiksQemuGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="Dorfiks VM GUI" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
        </Grid>
        <StackPanel Grid.Row="1">
        <InfoBar x:Name="WhpxBar" IsOpen="False" IsClosable="True" Severity="Warning"
                 Title="Hardware acceleration is off"
                 Message="Virtual machines run 10-50x slower without the Windows Hypervisor Platform. Enable it and restart Windows.">
            <InfoBar.ActionButton>
                <Button x:Name="WhpxButton" Content="Enable" Click="WhpxButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar x:Name="QemuBar" Grid.Row="0" IsOpen="False" IsClosable="False" Severity="Informational"
                 Title="QEMU" Message="">
            <InfoBar.Content>
                <ProgressBar x:Name="QemuProgress" Margin="0,0,0,12" Maximum="100" />
            </InfoBar.Content>
        </InfoBar>
        </StackPanel>
        <NavigationView x:Name="Nav" Grid.Row="2" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left"
                        IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Machines" Tag="machines" Icon="Library" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
