<Window x:Class="DorfiksSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar">
            <TextBlock Text="Dorfik's GUI for QEMU — Setup" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
        </Grid>
        <Grid Grid.Row="1" Padding="40,16,40,32">
            <!-- Page 1: options -->
            <StackPanel x:Name="PageWelcome" Spacing="16" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="48" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" Text="Install Dorfik's GUI for QEMU"/>
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                           Text="A friendly way to create and run virtual machines. QEMU itself is downloaded automatically the first time you start the app."/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Header="Install location"/>
                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click"/>
                </Grid>
                <CheckBox x:Name="DesktopBox" Content="Create a desktop shortcut" IsChecked="True"/>
                <TextBlock x:Name="Warn" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click"/>
                    <Button Content="Install" Style="{StaticResource AccentButtonStyle}" Click="Install_Click"/>
                </StackPanel>
            </StackPanel>
            <!-- Page 2: progress -->
            <StackPanel x:Name="PageProgress" Spacing="16" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Installing…" Style="{StaticResource TitleTextBlockStyle}"/>
                <ProgressBar x:Name="Bar" Maximum="100"/>
                <TextBlock x:Name="Status" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <!-- Page 3: done -->
            <StackPanel x:Name="PageDone" Spacing="16" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="48" HorizontalAlignment="Left" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource TitleTextBlockStyle}" Text="All set"/>
                <TextBlock x:Name="DoneSub" Opacity="0.75" TextWrapping="Wrap"/>
                <CheckBox x:Name="LaunchBox" Content="Launch Dorfik's GUI for QEMU" IsChecked="True"/>
                <Button Content="Finish" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="Finish_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
